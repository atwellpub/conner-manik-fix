<?xml version="1.0" encoding="UTF-8"?>
<!--
    MSI installer for MANIK Keyboard Fix (WiX Toolset v3).

    Per-user install: it goes into the signed-in user's own profile, so it
    never asks for an administrator password and works on a child account.

    Installs:   %LOCALAPPDATA%\Programs\MANIK Keyboard Fix\MANIK-Keyboard-Fix.exe
    Shortcuts:  Start menu and Desktop
    Uninstall:  removes all of the above, plus the two things the app creates
                itself while running (its settings file and its Startup shortcut)

    build.ps1 passes in Version, DistDir and AssetsDir.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="MANIK Keyboard Fix"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="atwellpub"
           UpgradeCode="8ED42DA8-529F-4C8A-BEEE-AADF225FC532">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Description="MANIK Keyboard Fix"
             Comments="Corrects swapped W A S D / arrow keys and Windows / Alt keys on a MANIK keyboard." />

    <MediaTemplate EmbedCab="yes" />

    <!--
        A newer MSI replaces an older one in place. The old version is removed
        after the new files are down, so the settings file and the Startup
        shortcut are kept across an upgrade and only removed by a real uninstall.
    -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Icon Id="AppIcon.ico" SourceFile="$(var.AssetsDir)\icon-on.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="MANIK Keyboard Fix" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
      <Directory Id="StartupFolder" />
      <Directory Id="AppDataFolder">
        <Directory Id="SettingsDir" Name="MANIK Keyboard Fix" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppComponent" Guid="5515CF29-2775-4C5C-900A-2173C90A660E">
        <File Id="AppExe" Source="$(var.DistDir)\MANIK-Keyboard-Fix.exe" />

        <!-- Windows Installer needs a per-user registry marker for a per-user install. -->
        <RegistryValue Root="HKCU" Key="Software\MANIK Keyboard Fix" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />

        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MANIK Keyboard Fix"
                  Description="Turn the MANIK keyboard correction on or off"
                  Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="MANIK Keyboard Fix"
                  Description="Turn the MANIK keyboard correction on or off"
                  Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />

        <!-- Created by the app at run time, so the installer has to be told to clean them up. -->
        <RemoveFile Id="RemoveStartupShortcut" Directory="StartupFolder" Name="MANIK Keyboard Fix.lnk" On="uninstall" />
        <RemoveFile Id="RemoveSettingsFile" Directory="SettingsDir" Name="settings.ini" On="uninstall" />
        <RemoveFolder Id="RemoveSettingsDir" Directory="SettingsDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="MANIK Keyboard Fix" Level="1">
      <ComponentRef Id="AppComponent" />
    </Feature>

    <!--
        Before an upgrade or an uninstall touches the exe, ask the running copy
        to exit. It lets go of any held keys and leaves the keyboard untouched.
    -->
    <CustomAction Id="CloseRunningApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]MANIK-Keyboard-Fix.exe&quot; /exit"
                  Return="ignore" />

    <!-- After a normal double-click install, open the app so there is something to see. -->
    <CustomAction Id="LaunchApp" FileKey="AppExe" ExeCommand="" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="InstallValidate">Installed OR WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="LaunchApp" After="InstallFinalize">NOT Installed AND UILevel &gt; 2</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
